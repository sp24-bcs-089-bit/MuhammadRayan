<!DOCTYPE html>
<html>
<head>
<title>Sales Dashboard</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: Arial, sans-serif; background: #f4f4f4; display: flex; }

.sidebar {
    width: 220px; min-height: 100vh; background: #141C23;
    color: white; padding: 30px 20px; position: fixed;
}
.sidebar h2 { font-size: 18px; margin-bottom: 30px; color: #7FAE9E; letter-spacing: 1px; }
.sidebar a { display: block; color: #ccc; text-decoration: none; padding: 10px 0; border-bottom: 1px solid #2a3540; font-size: 14px; }
.sidebar a:hover { color: white; }
.sidebar a.active { color: #7FAE9E; font-weight: bold; }

.main { margin-left: 220px; padding: 40px; width: 100%; }
.main h1 { font-size: 24px; margin-bottom: 6px; color: #141C23; }
.subtitle { font-size: 13px; color: #888; margin-bottom: 30px; }

.live-badge {
    display: inline-flex; align-items: center; gap: 6px;
    background: #e8f4f0; color: #5d9180; font-size: 12px;
    font-weight: 600; padding: 4px 12px; border-radius: 20px; margin-bottom: 28px;
}
.live-dot {
    width: 8px; height: 8px; background: #5d9180;
    border-radius: 50%; animation: pulse 1.5s infinite;
}
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

.stats { display: flex; gap: 20px; margin-bottom: 36px; flex-wrap: wrap; }
.stat-card {
    background: white; padding: 24px 32px; border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07); flex: 1; min-width: 180px;
    text-align: center; border-top: 4px solid #7FAE9E; transition: transform 0.2s;
}
.stat-card:hover { transform: translateY(-2px); }
.stat-card .icon { font-size: 26px; margin-bottom: 10px; }
.stat-card h3 { font-size: 32px; color: #141C23; font-weight: 700; }
.stat-card p { font-size: 12px; color: #999; margin-top: 4px; text-transform: uppercase; letter-spacing: 0.5px; }

.top-product-card {
    background: white; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.07);
    padding: 24px 28px; margin-bottom: 32px; border-left: 5px solid #D39A62;
}
.top-product-card h2 { font-size: 16px; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px; }
.top-product-card .product-name { font-size: 22px; font-weight: 700; color: #141C23; }
.top-product-card .product-meta { font-size: 13px; color: #888; margin-top: 6px; }
.top-product-card .product-meta span { margin-right: 20px; }
.no-data { color: #bbb; font-style: italic; }

.section-title { font-size: 16px; font-weight: 700; color: #141C23; margin-bottom: 14px; }
table { width: 100%; border-collapse: collapse; background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.07); }
th { background: #141C23; color: white; padding: 12px 16px; text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; }
td { padding: 12px 16px; border-bottom: 1px solid #eee; font-size: 13px; color: #444; }
tr:last-child td { border-bottom: none; }
tr:hover td { background: #fafafa; }

.status-badge { padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; text-transform: capitalize; }
.status-pending { background: #fff3cd; color: #856404; }
.status-completed { background: #d1e7dd; color: #0f5132; }
.status-cancelled { background: #f8d7da; color: #842029; }

.last-updated { font-size: 12px; color: #bbb; text-align: right; margin-top: 20px; }

@keyframes flashGreen { 0% { background-color: #e8f4f0; } 100% { background-color: white; } }
.updated { animation: flashGreen 0.8s ease-out; }
</style>
</head>
<body>

<div class="sidebar">
    <h2>☕ ADMIN</h2>
    <a href="/admin">📊 Dashboard</a>
    <a href="/admin/add">➕ Add Product</a>
    <a href="/sales" class="active">💰 Sales</a>
    <a href="/products">🛍 View Store</a>
    <a href="/">🏠 Home</a>
</div>

<div class="main">
    <h1>Sales Dashboard</h1>
    <p class="subtitle">Real-time overview of your store's performance</p>

    <div class="live-badge">
        <span class="live-dot"></span> LIVE — updates every 10 seconds
    </div>

    <div class="stats">
        <div class="stat-card">
            <div class="icon">💵</div>
            <h3 id="totalRevenue">PKR <%= totalRevenue.toLocaleString() %></h3>
            <p>Total Revenue</p>
        </div>
        <div class="stat-card">
            <div class="icon">🛒</div>
            <h3 id="totalOrders"><%= totalOrders %></h3>
            <p>Total Orders</p>
        </div>
        <div class="stat-card">
            <div class="icon">📦</div>
            <h3 id="avgOrderValue">PKR <%= totalOrders > 0 ? Math.round(totalRevenue / totalOrders).toLocaleString() : 0 %></h3>
            <p>Avg. Order Value</p>
        </div>
    </div>

    <div class="top-product-card">
        <h2>🏆 Top Selling Product</h2>
        <% if (topProduct) { %>
            <div class="product-name" id="topProductName"><%= topProduct.name %></div>
            <div class="product-meta">
                <span id="topProductSold">🔢 <strong><%= topProduct.totalSold %></strong> units sold</span>
                <span id="topProductRevenue">💰 PKR <strong><%= topProduct.revenue.toLocaleString() %></strong> revenue</span>
            </div>
        <% } else { %>
            <div class="no-data" id="topProductName">No sales data yet</div>
        <% } %>
    </div>

    <div class="section-title">Recent Orders</div>
    <table>
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Items</th>
                <th>Total (PKR)</th>
                <th>Status</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            <% if (recentOrders.length === 0) { %>
            <tr><td colspan="6" style="text-align:center; color:#bbb; font-style:italic;">No orders yet</td></tr>
            <% } %>
            <% recentOrders.forEach(order => { %>
            <tr>
                <td style="font-family:monospace; font-size:11px;">#<%= order._id.toString().slice(-6).toUpperCase() %></td>
                <td><%= order.user?.username || order.user?.email || 'Unknown' %></td>
                <td><%= order.items.length %> item(s)</td>
                <td><%= order.total.toLocaleString() %></td>
                <td><span class="status-badge status-<%= order.status %>"><%= order.status %></span></td>
                <td><%= new Date(order.createdAt).toLocaleDateString('en-PK', { day:'numeric', month:'short', year:'numeric' }) %></td>
            </tr>
            <% }) %>
        </tbody>
    </table>

    <div class="last-updated">Last updated: <span id="lastUpdated">just now</span></div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
$(document).ready(function () {

    function fmt(n) { return Number(n).toLocaleString("en-PK"); }

    function applyUpdate(data) {
        var avg = data.totalOrders > 0 ? Math.round(data.totalRevenue / data.totalOrders) : 0;

        function flash(selector) {
            $(selector).removeClass("updated");
            setTimeout(function () { $(selector).addClass("updated"); }, 10);
        }

        $("#totalRevenue").text("PKR " + fmt(data.totalRevenue)); flash("#totalRevenue");
        $("#totalOrders").text(data.totalOrders);                 flash("#totalOrders");
        $("#avgOrderValue").text("PKR " + fmt(avg));              flash("#avgOrderValue");

        if (data.topProduct) {
            $("#topProductName").text(data.topProduct.name);
            $("#topProductSold").html("🔢 <strong>" + data.topProduct.totalSold + "</strong> units sold");
            $("#topProductRevenue").html("💰 PKR <strong>" + fmt(data.topProduct.revenue) + "</strong> revenue");
        } else {
            $("#topProductName").text("No sales data yet");
        }

        $("#lastUpdated").text(new Date().toLocaleTimeString("en-PK"));
    }

    setInterval(function () {
        $.ajax({
            url: "/api/sales-data",
            method: "GET",
            dataType: "json",
            success: function (data) { applyUpdate(data); },
            error: function (xhr) { console.warn("Poll failed:", xhr.status); }
        });
    }, 10000);

});
</script>

</body>
</html>